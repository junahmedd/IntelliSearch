# ==============================================================================
# IntelliResearch Environment Configuration Template
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file or secret keys to version control!
# ==============================================================================

# ==============================================================================
# Search Provider Selection: "mock", "duckduckgo", or "tavily"
# - "mock": 100% offline deterministic test corpus (default; no internet/keys required)
# - "duckduckgo": Live real web search via DuckDuckGo HTML (free; NO API key required)
# - "tavily": AI-grounded search via Tavily API (requires TAVILY_API_KEY)
# ==============================================================================
SEARCH_PROVIDER=mock

# Optional: Tavily API Key (only needed if SEARCH_PROVIDER=tavily)
# TAVILY_API_KEY=your_tavily_api_key_here

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Default is "mock" (runs completely offline without an API key or internet access).
LLM_PROVIDER=mock

# Model Name:
# - For Groq (Free tier): llama-3.1-8b-instant or mixtral-8x7b-32768
# - For Ollama (Local): llama3 or mistral
# - For OpenAI: gpt-4o-mini
LLM_MODEL=llama-3.1-8b-instant

# API Base URL:
# - Groq: https://api.groq.com/openai/v1
# - Ollama (Local): http://localhost:11434/v1
# - OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# API Key:
# - Required for Groq / OpenAI. Not required for local Ollama.
# - Placeholder only below. Do NOT enter real keys here.
LLM_API_KEY=your_api_key_here

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=30
